// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DEALER
  CLIENT
}

enum DealerStaffRole {
  OWNER
  SALES
}

enum VehicleType {
  AUTO
  MOTO
  CAMION
  CAMIONETA
  UTILITARIO
  BUS
  OTRO
}

enum VehicleCondition {
  NEW   // 0km
  USED  // Usado
}

enum VehicleStatus {
  DRAFT    // Borrador (no visible)
  ACTIVE   // Publicado y activo
  SOLD     // Vendido
  PAUSED   // Pausa temporal
}

enum LeadStatus {
  NEW        // Recién llegado
  CONTACTED  // Ya contactado
  CLOSED     // Cerrado (ganado o perdido)
}

// ─── Models ──────────────────────────────────────────────────────────────────

/// Usuario del sistema. Puede ser Admin, Dealer (automotora) o Client (comprador).
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String? // Cloudflare R2 URL
  role         Role    @default(CLIENT)
  isActive     Boolean @default(true)

  dealerId        String?
  dealer          DealerProfile? @relation("DealerStaff", fields: [dealerId], references: [id])
  staffRole       DealerStaffRole?

  dealerProfile   DealerProfile? @relation("DealerOwner")
  vehicles        Vehicle[]      @relation("UserVehicles")
  managedVehicles Vehicle[]      @relation("SalesmanVehicles")
  leads           Lead[]         @relation("UserLeads")
  managedLeads    Lead[]         @relation("SalesmanLeads")

  favorites    Favorite[]
  auditLogs    AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

/// Perfil extendido para usuarios con rol DEALER (automotoras).
model DealerProfile {
  id           String  @id @default(cuid())
  ownerId      String  @unique
  owner        User    @relation("DealerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  staff        User[]  @relation("DealerStaff")
  businessName String
  rut          String? @unique // RUT uruguayo
  phone        String?
  whatsapp     String?
  address      String?
  city         String?
  logoUrl      String? // Cloudflare R2 URL
  bannerUrl    String? // Cloudflare R2 URL
  website      String?
  description  String? @db.Text
  verified     Boolean @default(false)

  vehicles Vehicle[]
  branches Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verified])
}

/// Marca de vehículos (e.g. Toyota, Honda, Yamaha).
model Brand {
  id         String  @id @default(cuid())
  name       String  @unique
  logoUrl    String? // Cloudflare R2 URL
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  models   Model[]
  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isFeatured])
}

/// Modelo de vehículo asociado a una marca (e.g. Corolla para Toyota).
model Model {
  id          String      @id @default(cuid())
  name        String
  vehicleType VehicleType @default(AUTO)
  brandId     String
  brand       Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, brandId])
  @@index([brandId])
  @@index([vehicleType])
}

/// Vehículo publicado en el marketplace.
model Vehicle {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text

  // Clasificación
  vehicleType VehicleType      @default(AUTO)
  condition   VehicleCondition @default(USED)
  status      VehicleStatus    @default(DRAFT)

  // Datos principales (Relaciones)
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])
  modelId String
  model   Model  @relation(fields: [modelId], references: [id])

  year     Int
  mileage  Int     @default(0) // km
  price    Decimal @db.Decimal(12, 2)
  currency String  @default("UYU")

  // Características técnicas (opcionales pero útiles para filtros)
  fuelType     String? // Nafta, Diesel, Eléctrico, Híbrido, GNC
  transmission String? // Manual, Automático, CVT
  color        String?
  engineSize   String? // e.g. "1.6", "2.0T"
  doors        Int?
  seats        Int?
  features     String[] // Array de equipamiento: ABS, Airbags, etc.

  // Relaciones de propiedad
  ownerId  String
  owner    User           @relation("UserVehicles", fields: [ownerId], references: [id])
  
  salesmanId String?
  salesman   User?        @relation("SalesmanVehicles", fields: [salesmanId], references: [id])

  dealerId String?
  dealer   DealerProfile? @relation(fields: [dealerId], references: [id])
  branchId String?
  branch   Branch?        @relation(fields: [branchId], references: [id])

  images     Image[]
  leads      Lead[]
  favorites  Favorite[]

  isFeatured  Boolean   @default(false)
  
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isFeatured])
  @@index([brandId])
  @@index([modelId])
  @@index([status])
  @@index([vehicleType])
  @@index([condition])
  @@index([year])
  @@index([price])
  @@index([dealerId])
  @@index([branchId])
}

/// Imagen asociada a un vehículo, almacenada en Cloudflare R2.
model Image {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  r2Key   String // Object key en el bucket de R2 (e.g. "vehicles/abc123/foto-1.webp")
  url     String // URL pública del CDN de R2
  alt     String?
  position Int    @default(0) // Orden de visualización
  isCover  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([isCover])
}

/// Lead (consulta/contacto) generado por un cliente sobre un vehículo.
model Lead {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  // El usuario que realiza la consulta (comprador)
  userId String?
  user   User?   @relation("UserLeads", fields: [userId], references: [id])

  // El vendedor asignado a este lead
  salesmanId String?
  salesman   User?   @relation("SalesmanLeads", fields: [salesmanId], references: [id])

  // Datos de contacto (siempre presentes)
  name    String
  email   String?
  phone   String?
  message String? @db.Text

  status LeadStatus @default(NEW)
  source String     @default("web") // web, whatsapp, phone, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([email])
}

/// Marcadores de favoritos para usuarios.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
  @@index([userId])
  @@index([vehicleId])
}

/// Sucursal de una automotora.
model Branch {
  id        String @id @default(cuid())
  dealerId  String
  dealer    DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  
  name      String
  address   String?
  city      String?
  phone     String?
  whatsapp  String?
  isActive  Boolean @default(true)

  vehicles  Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerId])
  @@index([city])
}

/// Registro de auditoría para rastrear cambios en el sistema.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // e.g., "CREATE", "UPDATE", "DELETE", "IMPORT"
  entity    String   // e.g., "VEHICLE", "LEAD", "BRAND", "USER"
  entityId  String
  details   String?  @db.Text // Descripción legible
  oldValue  Json?    // Estado anterior
  newValue  Json?    // Estado nuevo
  ipAddress String?
  userAgent String?
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}
