# Variables de entorno para admin-panel
# Copiar a .env.local y completar con valores reales

# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/autouuy_dev?schema=public"

# ── Autenticación (NextAuth v5) ────────────────────────────────────────────────
AUTH_SECRET="SAME_SECRET_AS_PORTAL_WEB"
AUTH_URL="http://localhost:3001"

# ── Cloudflare R2 ──────────────────────────────────────────────────────────────
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="autouuy-vehicles"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

NEXT_PUBLIC_R2_BASE_URL="https://cdn.autouuy.uy"

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NODE_ENV="development"
